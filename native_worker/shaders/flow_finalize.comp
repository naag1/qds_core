#version 450
layout(local_size_x = 256) in;
struct FlowEntry { uint occupied; uint protocol; uint src_port; uint dst_port; uint src_hi; uint src_lo; uint dst_hi; uint dst_lo; uint first_s; uint last_s; uint packet_count; uint total_bytes; };
layout(std430,binding=0) readonly buffer Table { FlowEntry entries[]; } flow_table;
layout(std430,binding=1) writeonly buffer Output { FlowEntry flows[]; } output_flows;
void main() { uint i=gl_GlobalInvocationID.x; if(i>=flow_table.entries.length()) return; output_flows.flows[i]=flow_table.entries[i]; }
