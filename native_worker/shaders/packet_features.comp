#version 450
layout(local_size_x = 256) in;
struct PacketMeta { uint pkt_length; uint protocol; uint src_port; uint dst_port; };
struct Feature { float length; float protocol; float src_port; float dst_port; };
layout(std430, binding = 0) readonly buffer Input { PacketMeta packets[]; } input_packets;
layout(std430, binding = 1) writeonly buffer Output { Feature features[]; } output_features;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= input_packets.packets.length()) return;
    output_features.features[i] = Feature(float(input_packets.packets[i].pkt_length), float(input_packets.packets[i].protocol), float(input_packets.packets[i].src_port), float(input_packets.packets[i].dst_port));
}
